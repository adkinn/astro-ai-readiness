---
import { config } from 'virtual:ai-readiness-config'
import { jsonLd } from '../utils/json-ld'
import { publisherId } from '../utils/identity'
import type { TechArticleAuthor, TechArticleImage } from './types'

interface Props {
  // Required
  headline: string
  description: string
  datePublished: string

  // Optional — common
  dateModified?: string
  author?: TechArticleAuthor
  image?: TechArticleImage
  url?: string

  // Optional — Schema.org TechArticle extensions
  articleSection?: string
  keywords?: string[]
  proficiencyLevel?: string
  dependencies?: string[]
}

const {
  headline,
  description,
  datePublished,
  dateModified,
  author,
  image,
  url,
  articleSection,
  keywords,
  proficiencyLevel,
  dependencies,
} = Astro.props

// D-21: author defaults to a Person synthesized from the site's own identity —
// `organization.founder` for a company site, `person` for a solo one. A person-first
// site has no organization to hang a founder off, so requiring one there would be
// asking for a block that config shape cannot hold.
//
// Guard: if author is omitted and neither identity offers a name, fail loudly at
// build time rather than tighten the global schema (which would break consumers who
// don't use TechArticle).
const founder = config.organization?.founder
const authorSource = founder ?? config.person
let resolvedAuthor: TechArticleAuthor
if (author) {
  resolvedAuthor = author
} else {
  if (!authorSource) {
    throw new Error(
      'TechArticleSchema: `author` prop omitted and no author identity is ' +
      'configured. Either pass an explicit `author` prop, or — depending on how ' +
      'your site is configured — add a `founder` block to `organization`, or a ' +
      '`person` block, in your `aiReadiness({...})` integration call.'
    )
  }
  const authorUrl = authorSource.url ?? authorSource.sameAs?.[0]
  resolvedAuthor = {
    name: authorSource.name,
    ...(authorUrl && { url: authorUrl }),
  }
}

const resolvedImage =
  typeof image === 'string'
    ? { '@type': 'ImageObject', url: image }
    : image
      ? { '@type': 'ImageObject', ...image }
      : undefined

const resolvedUrl = url ?? new URL(Astro.url.pathname, config.site).toString()

const ta: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline,
  description,
  datePublished,
  dateModified: dateModified ?? datePublished,
  author: { '@type': 'Person', ...resolvedAuthor },
  publisher: { '@id': publisherId(config) },
  url: resolvedUrl,
}

if (resolvedImage) ta.image = resolvedImage
if (articleSection) ta.articleSection = articleSection
if (keywords && keywords.length > 0) ta.keywords = keywords.join(', ')
if (proficiencyLevel) ta.proficiencyLevel = proficiencyLevel
if (dependencies && dependencies.length > 0) ta.dependencies = dependencies.join(', ')
---
<script is:inline type="application/ld+json" set:html={jsonLd(ta)}></script>
