{
  "name": "@obaronai/astro-ai-readiness",
  "version": "0.0.5",
  "description": "AI Readiness toolkit for Astro — six JSON-LD helper components today (Organization, WebSite, CollectionPage, Breadcrumb, FAQPage, TechArticle). File outputs (llms.txt, agents.md, mcp.json, robots.txt rules) on the v0.1 roadmap.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/components/*.astro dist/components/",
    "typecheck": "tsc --noEmit",
    "test": "echo 'tests not configured yet — stub-failing per repo-management.md hygiene' && exit 1",
    "lint": "echo 'lint not configured yet — stub-failing per repo-management.md hygiene' && exit 1"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "ai-readiness",
    "aeo",
    "agent-readable",
    "llms-txt",
    "llms-full-txt",
    "agents-md",
    "mcp",
    "robots-txt",
    "schema-org",
    "json-ld",
    "astro-integration",
    "astro-component",
    "withastro"
  ],
  "author": {
    "name": "Adam Kinney",
    "email": "hi@obaron.ai",
    "url": "https://adamkinney.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obaronai/astro-ai-readiness.git"
  },
  "homepage": "https://github.com/obaronai/astro-ai-readiness#readme",
  "bugs": {
    "url": "https://github.com/obaronai/astro-ai-readiness/issues"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
