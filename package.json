  "keywords": [
    "ai-readiness",
    "llms-txt",
    "llms-full-txt",
    "agents-md",
    "mcp",
    "robots-txt",
    "schema-org",
    "json-ld",
    "astro-integration",
    "astro-component",
    "withastro"
  ],
  "author": {
    "name": "Adam Kinney",
